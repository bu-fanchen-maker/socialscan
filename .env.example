# Social Scan credentials — sources with missing values skip themselves.

# Claude pass (scan/classify.py). Required unless running with --no-llm.
ANTHROPIC_API_KEY=

# Bilibili search API needs a logged-in cookie (scan/sources/bilibili.py).
# Copy the full Cookie header from a logged-in bilibili.com request.
BILIBILI_COOKIE=

# X search via Playwright (scan/sources/x_search.py). Path to a Playwright
# storage_state JSON exported from a logged-in x.com session. Only needed
# without --no-x.
X_STORAGE_STATE=

# TODO sources (scan/sources/stubs.py) — leave empty for now.
DATAEYE_STORAGE_STATE=
SENSORTOWER_TOKEN=
